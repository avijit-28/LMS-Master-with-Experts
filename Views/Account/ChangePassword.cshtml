@model LMS.ViewModels.ChangePasswordViewModel
@{
    ViewBag.Title = "Change Password";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a href="@Url.Action("Profile", "Account")" class="text-decoration-none text-cyan">Profile</a></li>
                <li class="breadcrumb-item active text-white opacity-75" aria-current="page">Security</li>
            </ol>
        </nav>

        <div class="card card-custom p-4 p-md-5 shadow-sm card-gradient-top border-0" style="background: rgba(6, 35, 48, 0.95); border: 1px solid rgba(39, 184, 214, 0.25) !important;">
            <div class="d-flex align-items-center gap-3 mb-4 pb-3" style="border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                <div class="rounded-circle p-3 d-flex align-items-center justify-content-center shadow-xs" style="width: 50px; height: 50px; background: rgba(255, 122, 24, 0.15); color: #FF7A18; border: 1px solid rgba(255, 122, 24, 0.35);">
                    <i class="bi bi-shield-lock-fill fs-4"></i>
                </div>
                <div>
                    <h4 class="fw-extrabold mb-0 tracking-tight text-white">Change Password</h4>
                    <p class="small mb-0" style="color: #94A3B8;">Update your security credentials</p>
                </div>
            </div>

            @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger rounded-3 mb-3 small" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.OldPassword, "Current Password", new { @class = "form-label fw-bold small text-white" })
                    <div class="input-group">
                        @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control", placeholder = "Enter current password", required = "required", style = "background: rgba(4, 24, 34, 0.85); border: 1px solid rgba(255, 255, 255, 0.2); color: #FFFFFF;" })
                        <button class="btn btn-outline-secondary toggle-password-btn" type="button" tabindex="-1" style="border-color: rgba(255, 255, 255, 0.2); color: #94A3B8; background: rgba(4, 24, 34, 0.85);">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    @Html.ValidationMessageFor(m => m.OldPassword, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.NewPassword, "New Password", new { @class = "form-label fw-bold small text-white" })
                    <div class="input-group">
                        @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", placeholder = "At least 8 characters with letter, number & symbol", required = "required", style = "background: rgba(4, 24, 34, 0.85); border: 1px solid rgba(255, 255, 255, 0.2); color: #FFFFFF;" })
                        <button class="btn btn-outline-secondary toggle-password-btn" type="button" tabindex="-1" style="border-color: rgba(255, 255, 255, 0.2); color: #94A3B8; background: rgba(4, 24, 34, 0.85);">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-4">
                    @Html.LabelFor(m => m.ConfirmPassword, "Confirm New Password", new { @class = "form-label fw-bold small text-white" })
                    <div class="input-group">
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Re-enter new password", required = "required", style = "background: rgba(4, 24, 34, 0.85); border: 1px solid rgba(255, 255, 255, 0.2); color: #FFFFFF;" })
                        <button class="btn btn-outline-secondary toggle-password-btn" type="button" tabindex="-1" style="border-color: rgba(255, 255, 255, 0.2); color: #94A3B8; background: rgba(4, 24, 34, 0.85);">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                </div>

                <div class="p-3 rounded-3 mb-4 small" style="background: rgba(11, 52, 69, 0.65); border: 1px solid rgba(39, 184, 214, 0.35);">
                    <div class="fw-bold mb-2 text-white"><i class="bi bi-shield-lock me-1 text-cyan"></i> Password Rules (Must contain all 4):</div>
                    <div class="d-flex flex-wrap gap-2 mt-1" style="font-size: 11px;">
                        <span class="badge px-2 py-1 rounded-pill" style="background: rgba(6, 35, 48, 0.9); color: #CBD5E1; border: 1px solid rgba(255, 255, 255, 0.15);"><i class="bi bi-check2 text-success me-1"></i>Min 8 characters</span>
                        <span class="badge px-2 py-1 rounded-pill" style="background: rgba(6, 35, 48, 0.9); color: #CBD5E1; border: 1px solid rgba(255, 255, 255, 0.15);"><i class="bi bi-check2 text-success me-1"></i>Uppercase (A-Z)</span>
                        <span class="badge px-2 py-1 rounded-pill" style="background: rgba(6, 35, 48, 0.9); color: #CBD5E1; border: 1px solid rgba(255, 255, 255, 0.15);"><i class="bi bi-check2 text-success me-1"></i>Lowercase (a-z)</span>
                        <span class="badge px-2 py-1 rounded-pill" style="background: rgba(6, 35, 48, 0.9); color: #CBD5E1; border: 1px solid rgba(255, 255, 255, 0.15);"><i class="bi bi-check2 text-success me-1"></i>Digit (0-9)</span>
                        <span class="badge px-2 py-1 rounded-pill" style="background: rgba(6, 35, 48, 0.9); color: #CBD5E1; border: 1px solid rgba(255, 255, 255, 0.15);"><i class="bi bi-check2 text-success me-1"></i>Symbol (!@@#$%...)</span>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3" style="border-top: 1px solid rgba(255, 255, 255, 0.1);">
                    <a href="@Url.Action("Profile", "Account")" class="btn btn-outline-light rounded-pill px-4" style="border-color: rgba(255, 255, 255, 0.25);">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                        <i class="bi bi-shield-check me-1"></i> Update Password
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
