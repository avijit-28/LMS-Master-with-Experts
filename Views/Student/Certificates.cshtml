@model IEnumerable<LMS.Models.Certificate>
@{
    ViewBag.Title = "My Earned Certificates";
}

<div class="py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <span class="badge px-3 py-1 rounded-pill mb-2 fw-semibold" style="background: rgba(255, 122, 24, 0.15); color: #FF7A18; border: 1px solid rgba(255, 122, 24, 0.35);">
                <i class="bi bi-award-fill me-1"></i> Accredited Credentials
            </span>
            <h2 class="fw-extrabold mb-1 tracking-tight text-white">Official Certificates of Completion</h2>
            <p class="small mb-0" style="color: #94A3B8;">Credentials earned across verified, 100% completed course curriculums</p>
        </div>
        <a href="@Url.Action("VerifyCertificate", "Certificate")" class="btn btn-outline-light rounded-pill px-4 fw-semibold" style="border-color: rgba(255, 255, 255, 0.25);">
            <i class="bi bi-shield-check me-1 text-cyan"></i> Verify a Credential
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card card-custom p-5 text-center shadow-sm" style="background: rgba(6, 35, 48, 0.92); border: 1px solid rgba(255, 255, 255, 0.12);">
            <div class="rounded-circle p-4 d-inline-flex mx-auto mb-3 shadow-xs" style="background: rgba(255, 122, 24, 0.15); color: #FF7A18; border: 1px solid rgba(255, 122, 24, 0.35);">
                <i class="bi bi-award fs-1"></i>
            </div>
            <h4 class="fw-bold text-white mb-2">No certificates earned yet.</h4>
            <p class="small mb-4" style="color: #94A3B8; max-width: 540px; margin: 0 auto;">Complete 100% of the lessons and assessments in any enrolled course to automatically receive your verified certificate.</p>
            <div>
                <a href="@Url.Action("MyCourses", "Student")" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                    <i class="bi bi-journal-bookmark-fill me-1"></i> Go to My Courses
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var cert in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card card-custom p-4 shadow-sm h-100 card-hover" style="background: rgba(6, 35, 48, 0.92); border: 1px solid rgba(255, 255, 255, 0.12); border-top: 4px solid #FF7A18;">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="badge px-3 py-1 rounded-pill small fw-bold" style="background: rgba(255, 122, 24, 0.15); color: #FF7A18; border: 1px solid rgba(255, 122, 24, 0.3);">
                                <i class="bi bi-patch-check-fill me-1"></i> Verified Credential
                            </span>
                            <small class="font-monospace" style="font-size: 11px; color: #94A3B8;">@cert.IssueDate.ToString("MMM dd, yyyy")</small>
                        </div>

                        <h5 class="fw-bold text-white mb-2">@(cert.Course?.Title ?? "Course")</h5>
                        <p class="small mb-3 font-monospace" style="color: #94A3B8;">Certificate ID: <strong class="text-cyan">@cert.CertificateNumber</strong></p>

                        <div class="d-flex justify-content-between align-items-center p-3 rounded-3 mb-4" style="background: rgba(11, 52, 69, 0.6); border: 1px solid rgba(39, 184, 214, 0.25);">
                            <span class="small fw-semibold" style="color: #CBD5E1;">Final Score:</span>
                            <span class="fs-5 fw-extrabold text-success">@(cert.FinalScore.HasValue ? cert.FinalScore.Value.ToString("0.0") + "%" : "100.0%")</span>
                        </div>

                        <div class="mt-auto">
                            <a href="@Url.Action("ViewCertificate", "Certificate", new { id = cert.CertificateId })" class="btn btn-primary rounded-pill w-100 fw-bold shadow-sm">
                                <i class="bi bi-eye-fill me-1"></i> View & Print Certificate
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
